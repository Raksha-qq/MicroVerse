datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  username         String?           @unique
  passwordHash     String
  name             String
  role             String            @default("USER") // USER | ADMIN
  bio              String?
  avatar           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  progress         UserProgress[]
  lessonProgress   LessonProgress[]
  attempts         QuizAttempt[]
  bookmarks        Bookmark[]
  savedExperiments SavedExperiment[]
  researchNotes    ResearchNote[]
  badges           UserBadge[]

  @@index([email])
  @@index([username])
  @@index([role])
}

model Controller {
  id                  String         @id @default(uuid())
  name                String         @unique
  commonName          String
  slug                String?        @unique
  family              String         // 8051 | AVR | PIC | ARM Cortex-M | STM32 | ESP32 | RP2040
  architecture        String         // e.g. ARMv7E-M, AVR 8-bit RISC, Xtensa LX6, etc.
  core                String         // Cortex-M4, AVR, Xtensa LX6, Cortex-M0+, etc.
  coreCount           Int            @default(1)
  manufacturer        String         // STMicroelectronics, Microchip, Espressif, Raspberry Pi, etc.
  bitWidth            Int            // 8, 16, 32
  maxClockSpeedMHz    Float
  flashKb             Float
  sramKb              Float
  eepromKb            Float?
  operatingVoltageMin Float
  operatingVoltageMax Float
  logicLevel          String         // "3.3V", "5V", etc.
  gpioCount           Int
  adcChannels         Int
  adcResolutionBits   Int
  dacChannels         Int            @default(0)
  timers              Int
  pwmChannels         Int            @default(0)
  uartCount           Int
  spiCount            Int
  i2cCount            Int
  canCount            Int            @default(0)
  usbSupport          Boolean        @default(false)
  wireless            String?
  fpu                 Boolean        @default(false)
  dsp                 Boolean        @default(false)
  dmaChannels         Int            @default(0)
  deepSleepCurrentUa  Float?
  packageTypes        String
  description         String
  architecturalNotes  String
  applications        String?        // Comma-separated or descriptive applications: Robotics, IoT, Motor Control, TinyML
  developmentTools    String?        // Supported IDEs, compilers, debuggers
  advantages          String?        // Key architectural advantages
  limitations         String?        // Key architectural limitations
  roboticsApplications String?       // Specific robotics use cases
  technicalSources    String?        // Official reference datasheets & manuals
  verifiedAt          DateTime?      @default(now())
  datasheetUrl        String
  pinoutDiagram       String?
  specifications      Json?          // Flexible register maps, clock trees & hardware registers
  pinoutConfig        Json?          // Interactive pin mapping metadata (multiplexing, modes)
  isFeatured          Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  bookmarks           Bookmark[]
  researchNotes       ResearchNote[]

  @@index([family])
  @@index([architecture])
  @@index([manufacturer])
  @@index([bitWidth])
  @@index([slug])
  @@index([isFeatured])
}

model Chapter {
  id               String         @id @default(uuid())
  chapterNumber    Int            @unique
  title            String
  slug             String         @unique
  summary          String
  level            String         // BEGINNER | INTERMEDIATE | ADVANCED
  estimatedMinutes Int
  content          String
  keyTakeaways     String         // JSON array of strings or serialized takeaways
  isPublished      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lessons          Lesson[]
  quiz             Quiz?
  userProgress     UserProgress[]
  researchNotes    ResearchNote[]

  @@index([level])
  @@index([isPublished])
}

model Lesson {
  id               String           @id @default(uuid())
  chapterId        String
  chapter          Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessonNumber     Int
  title            String
  slug             String           @unique
  summary          String
  content          String
  difficulty       String           @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  estimatedMinutes Int              @default(15)
  order            Int              @default(1)
  isPublished      Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  userProgress     LessonProgress[]
  researchNotes    ResearchNote[]

  @@index([chapterId])
  @@index([slug])
  @@index([difficulty])
  @@index([isPublished])
}

model LessonProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  lastAccessedAt DateTime  @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([isCompleted])
}

model Quiz {
  id           String         @id @default(uuid())
  chapterId    String         @unique
  chapter      Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title        String
  description  String
  passingScore Int            @default(70)
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([chapterId])
}

model QuizQuestion {
  id                 String   @id @default(uuid())
  quizId             String
  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question           String
  codeSnippet        String?
  options            String   // JSON array of strings
  correctOptionIndex Int      // 0-based index
  explanation        String
  points             Int      @default(10)
  createdAt          DateTime @default(now())

  @@index([quizId])
}

model UserProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId      String
  chapter        Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  lastAccessedAt DateTime  @default(now())

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
  @@index([isCompleted])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int      // Earned points
  totalPoints Int      // Total possible points
  passed      Boolean
  answers     String   // JSON object of chosen options
  attemptedAt DateTime @default(now())

  @@index([userId])
  @@index([quizId])
  @@index([attemptedAt])
}

model Bookmark {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType   String      // CONTROLLER | CHAPTER | LESSON | EXPERIMENT | ROBOTICS
  itemId     String
  controller Controller? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@index([itemType])
  @@index([itemId])
}

model SavedExperiment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  experimentType String   // GPIO | PWM | PROTOCOL | PID | BREADBOARD
  configState    String   // JSON string or serialized simulation state
  schematicData  Json?    // Breadboard wiring and simulator component layout
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([experimentType])
  @@index([createdAt])
}

model ResearchNote {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  content      String
  category     String      @default("GENERAL") // ARCHITECTURE | PERIPHERAL | PROTOCOL | EXPERIMENT | ROBOTICS | GENERAL
  tags         String?     // Comma separated tags e.g. "STM32,GPIO,Interrupts"
  controllerId String?
  controller   Controller? @relation(fields: [controllerId], references: [id], onDelete: SetNull)
  chapterId    String?
  chapter      Chapter?    @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  lessonId     String?
  lesson       Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  isPublic     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([category])
  @@index([controllerId])
  @@index([chapterId])
  @@index([lessonId])
  @@index([createdAt])
}

model Badge {
  id          String      @id @default(uuid())
  code        String      @unique
  title       String
  description String
  icon        String
  category    String
  userBadges  UserBadge[]

  @@index([category])
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}
