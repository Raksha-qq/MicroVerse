# =======================================================
# MICROVERSE Backend Environment Configuration Template
# =======================================================

# Port on which the Express server listens
PORT=5000

# PostgreSQL connection string with schema
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/microverse?schema=public"

# Secret key used for signing JWT access tokens (minimum 32 characters in production)
JWT_SECRET="microverse_development_secret_key_replace_in_production_environment_32chars"

# JWT token expiration window (e.g. "1d", "7d", "30d")
JWT_EXPIRES_IN="7d"

# Allowed CORS origins for the frontend client
CORS_ORIGIN="http://localhost:5173"

# Node execution environment ("development", "test", "production")
NODE_ENV="development"

# Rate limiting max requests per 15-minute window
RATE_LIMIT_MAX=300

