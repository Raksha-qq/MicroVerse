datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             String            @default("USER") // USER | ADMIN
  bio              String?
  avatar           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  progress         UserProgress[]
  attempts         QuizAttempt[]
  bookmarks        Bookmark[]
  savedExperiments SavedExperiment[]
  badges           UserBadge[]
}

model Controller {
  id                  String     @id @default(uuid())
  name                String     @unique
  commonName          String
  family              String // 8051 | AVR | PIC | ARM Cortex-M | STM32 | ESP32 | RP2040
  architecture        String // e.g. ARMv7E-M, AVR 8-bit RISC, Xtensa LX6, etc.
  core                String // Cortex-M4, AVR, Xtensa LX6, Cortex-M0+, etc.
  manufacturer        String // STMicroelectronics, Microchip, Espressif, Raspberry Pi, etc.
  bitWidth            Int // 8, 16, 32
  maxClockSpeedMHz    Float
  flashKb             Float
  sramKb              Float
  eepromKb            Float?
  operatingVoltageMin Float
  operatingVoltageMax Float
  logicLevel          String // "3.3V", "5V", etc.
  gpioCount           Int
  adcChannels         Int
  adcResolutionBits   Int
  dacChannels         Int        @default(0)
  timers              Int
  uartCount           Int
  spiCount            Int
  i2cCount            Int
  canCount            Int        @default(0)
  usbSupport          Boolean    @default(false)
  wireless            String?
  fpu                 Boolean    @default(false)
  dsp                 Boolean    @default(false)
  dmaChannels         Int        @default(0)
  deepSleepCurrentUa  Float?
  packageTypes        String
  description         String
  architecturalNotes  String
  datasheetUrl        String
  pinoutDiagram       String?
  isFeatured          Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  bookmarks           Bookmark[]
}

model Chapter {
  id               String         @id @default(uuid())
  chapterNumber    Int            @unique
  title            String
  slug             String         @unique
  summary          String
  level            String // BEGINNER | INTERMEDIATE | ADVANCED
  estimatedMinutes Int
  content          String
  keyTakeaways     String // JSON array of strings
  isPublished      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  quiz             Quiz?
  userProgress     UserProgress[]
}

model Quiz {
  id           String         @id @default(uuid())
  chapterId    String         @unique
  chapter      Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title        String
  description  String
  passingScore Int            @default(70)
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model QuizQuestion {
  id                 String   @id @default(uuid())
  quizId             String
  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question           String
  codeSnippet        String?
  options            String // JSON array of strings
  correctOptionIndex Int // 0-based index
  explanation        String
  points             Int      @default(10)
  createdAt          DateTime @default(now())
}

model UserProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId      String
  chapter        Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  lastAccessedAt DateTime  @default(now())

  @@unique([userId, chapterId])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int // Earned points
  totalPoints Int // Total possible points
  passed      Boolean
  answers     String // JSON object of chosen options
  attemptedAt DateTime @default(now())
}

model Bookmark {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType   String // CONTROLLER | CHAPTER | ROBOTICS
  itemId     String
  controller Controller? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([userId, itemType, itemId])
}

model SavedExperiment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  experimentType String // GPIO | PWM | PROTOCOL | PID | BREADBOARD
  configState    String // JSON string of simulation state
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Badge {
  id          String      @id @default(uuid())
  code        String      @unique
  title       String
  description String
  icon        String
  category    String
  userBadges  UserBadge[]
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
}
